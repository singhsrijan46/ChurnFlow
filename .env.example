# Application Configuration
APP_NAME=ChurnFlow
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=customer-churn-prediction
MODEL_NAME=churn_prediction_model
MODEL_VERSION=latest
MODEL_STAGE=Production

# Database Configuration (PostgreSQL for MLflow / Metadata)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlflow

# Monitoring & Drift Thresholds
DRIFT_THRESHOLD=0.20
MIN_AUC=0.80
MIN_F1=0.70

# AWS S3 / Cloud Artifacts (Optional for Cloud Deployments)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=churn-mlops-artifacts
ECR_REPOSITORY_URL=
